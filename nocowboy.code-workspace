{
  "folders": [{ "path": "." }],
  "settings": {
    "search.exclude": {
      "**/.git": true,
      "**/dist": true,
      "**/node_modules": true,
      "**/.kilo": true,
      "**/.kilocode": true,
      "**/.opencode": true
    },
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/dist": true
    },
    "typescript.preferences.autoImportFileExcludePatterns": ["**/node_modules/**", "**/.kilo/**", "**/.kilocode/**"]
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "oven.bun-vscode"
    ]
  }
}
