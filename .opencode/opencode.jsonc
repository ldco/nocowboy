{
  "$schema": "https://app.kilo.ai/config.json",
  // "enterprise": {
  //   "url": "https://enterprise.dev.opencode.ai",
  // },
  "provider": {
    "kilo": {
      "options": {},
    },
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
      "*": "ask",
    },
  },
  "mcp": {
    "local": {
      "type": "local",
      "command": [
        "node",
        "local.js"
      ],
      "enabled": true
    },
    "shared": {
      "enabled": true
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "disabled_providers": [],
  "lsp": true,
  "username": "patched-user",
  "formatter": false,
  "indexing": {
    "enabled": true,
    "provider": "voyage",
  },
}
