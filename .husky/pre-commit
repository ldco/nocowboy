#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# ── Pipeline integrity check ──
# Перенесён в .husky/commit-msg: git не пишет COMMIT_EDITMSG до pre-commit,
# поэтому при `commit -m` здесь читалось сообщение ПРОШЛОГО коммита и
# невиновные коммиты блокировались (проверка по feature-ID из сообщения).

# ── Typecheck (blocking, forced) ──
# Blocking: a hook that warns and continues is how 17 real type errors survived
# behind "clean" commits. Forced: tsgo's incremental cache can skip files it
# already checked, so only a full program check tells the truth.
if [ -f "$ROOT/turbo.json" ] && command -v bun &>/dev/null; then
  cd "$ROOT"
  bun turbo typecheck --force || exit 1
elif [ -f "$ROOT/packages/opencode/package.json" ] && command -v bun &>/dev/null; then
  cd "$ROOT/packages/opencode" && bun run typecheck || exit 1
fi

# ── Quality ratchet (fast, blocking) ──
# Empty catch blocks must explain themselves; as-any may not grow.
if [ -f "$ROOT/scripts/quality-ratchet.ts" ] && command -v bun &>/dev/null; then
  cd "$ROOT"
  bun run "$ROOT/scripts/quality-ratchet.ts" || exit 1
fi

# ── Roadmap verification ──
# Priority: repo-local scripts (the format this repo's docs use) → dev source → global

if [ -f "$ROOT/scripts/verify-roadmap.ts" ] && command -v bun &>/dev/null; then
  # This repo ships its own generators/verifier; they are the source of truth
  # for the docs/ format.
  cd "$ROOT"
  # Regenerate (fail loudly — never swallow a generator error), then stage the
  # generated docs. pre-commit runs AFTER `git add`, so rewriting the working
  # tree alone would leave the staged — and committed — snapshot stale.
  bun run "$ROOT/scripts/generate-docs.ts" || exit 1
  git add -- docs/ROADMAP.md docs/CHANGELOG.md docs/BACKLOG.md
  bun run "$ROOT/scripts/verify-roadmap.ts"
elif [ -f "$ROOT/packages/opencode/src/index.ts" ] && command -v bun &>/dev/null; then
  # NoCowboy dev project without repo-local scripts: use source tree
  cd "$ROOT"
  bun run --cwd "$ROOT/packages/opencode" src/index.ts roadmap generate 2>/dev/null || true
  bun run --cwd "$ROOT/packages/opencode" src/index.ts roadmap verify
elif command -v nocowboy &>/dev/null; then
  # Fallback: globally installed nocowboy
  cd "$ROOT"
  nocowboy roadmap generate 2>/dev/null || true
  nocowboy roadmap verify
fi
