#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# ── Pipeline integrity check ──
# Перенесён в .husky/commit-msg: git не пишет COMMIT_EDITMSG до pre-commit,
# поэтому при `commit -m` здесь читалось сообщение ПРОШЛОГО коммита и
# невиновные коммиты блокировались (проверка по feature-ID из сообщения).

# ── Typecheck (non-fatal — pre-existing plugin errors may fail) ──
if [ -f "$ROOT/packages/opencode/package.json" ]; then
  cd "$ROOT/packages/opencode" && bun run typecheck || echo "⚠️ typecheck failed (pre-existing errors, continuing)"
  cd "$ROOT"
fi

# ── Roadmap verification ──
# Priority: dev source (latest) → standalone scripts → global nocowboy (may lag)

if [ -f "$ROOT/packages/opencode/src/index.ts" ] && command -v bun &>/dev/null; then
  # NoCowboy dev project: use source tree (always latest)
  cd "$ROOT"
  bun run --cwd "$ROOT/packages/opencode" src/index.ts roadmap generate 2>/dev/null || true
  bun run --cwd "$ROOT/packages/opencode" src/index.ts roadmap verify
elif [ -f "$ROOT/scripts/verify-roadmap.ts" ] && command -v bun &>/dev/null; then
  # Fallback: standalone scripts
  cd "$ROOT"
  bun run "$ROOT/scripts/generate-docs.ts" 2>/dev/null || true
  bun run "$ROOT/scripts/verify-roadmap.ts"
elif command -v nocowboy &>/dev/null; then
  # Fallback: globally installed nocowboy
  cd "$ROOT"
  nocowboy roadmap generate 2>/dev/null || true
  nocowboy roadmap verify
fi
