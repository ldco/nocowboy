{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "plugin-registry": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9200/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9201/mcp",
      "enabled": true
    },
    "sqlite": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9202/mcp",
      "enabled": true
    },
    "puppeteer": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9203/mcp",
      "enabled": true
    },
    "nutausik": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9204/mcp",
      "enabled": true
    },
    "git": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9205/mcp",
      "enabled": true
    },
    "puppetmaster": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9206/mcp",
      "enabled": true
    },
    "ralph": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9207/mcp",
      "enabled": true
    },
    "constitution": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9208/mcp",
      "enabled": true
    },
    "ncp-validator": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9209/mcp",
      "enabled": true
    },
    "contract-guard": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9210/mcp",
      "enabled": true
    },
    "score-engine": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9211/mcp",
      "enabled": true
    },
    "hooks": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9212/mcp",
      "enabled": true
    }
  },
  "lsp": true,
  "indexing": {
    "enabled": true,
    "provider": "voyage",
    "model": "voyage-code-3",
    "vectorStore": "lancedb"
  },
  "instructions": [
    "/home/ldco/.config/nocowboy/instructions/*.md",
    "/home/ldco/.config/nocowboy/instructions/rules/*.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "*": "allow",
    "bash": {
      "^(sudo\\s+)?rm\\s+-rf\\s+/\\s*$": "ask",
      "^(sudo\\s+)?rm\\s+-rf\\s+/*\\s*$": "ask",
      "^(sudo\\s+)?rm\\s+-rf\\s+~\\s*$": "ask",
      "^(sudo\\s+)?rm\\s+-rf\\s+\\.\\s*$": "ask",
      "^(sudo\\s+)?dd\\s+if=": "ask",
      "^(sudo\\s+)?mkfs\\.|^(sudo\\s+)?fdisk|^(sudo\\s+)?parted|^(sudo\\s+)?mkswap": "ask",
      "^[Dd][Rr][Oo][Pp]\\s+(DATABASE|TABLE|SCHEMA|INDEX)": "ask",
      "^[Tt][Rr][Uu][Nn][Cc][Aa][Tt][Ee]\\b": "ask",
      "^redis-cli\\b.*(FLUSHALL|FLUSHDB)": "ask",
      "^mongo\\b.*db\\.dropDatabase": "ask",
      "^(sudo\\s+)?chmod\\s+777\\s+/": "ask",
      "^git\\s+push\\s+.*(--force|-f)\\b": "ask",
      "*": "allow"
    },
    "edit": {
      "(^|/)kilo\\.json$": "ask",
      "(^|/)nocowboy\\.json$": "ask",
      "*": "allow"
    }
  },
  "agent": {
    "architect": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "description": "Senior Software Architect — deep design analysis, ADRs, trade-off evaluation, C4 modeling, NFR-driven architecture",
      "groups": ["read", "command", "mcp"],
      "path": "~/.config/nocowboy/agent/architect.md",
      "edit": {
        "(^|/)(prd\\.json|docs/.*\\.(md|json))$": "allow",
        "*": "deny"
      }
    },
    "overseer": {
      "mode": "primary",
      "model": "kimi-for-coding/kimi-k2-thinking",
      "description": "Strict review and orchestration agent. Delegates to code, reviews with fresh eyes. Uses different model than code to catch model-blindness bugs.",
      "groups": ["read", "command", "mcp"],
      "webfetch": "allow",
      "websearch": "allow",
      "skill": "allow",
      "recall": "allow",
      "external_directory": "allow"
    }
    },
    "overseer": {
      "mode": "primary",
      "model": "kimi-for-coding/kimi-k2-thinking",
      "description": "Strict review and orchestration agent. Delegates to code, reviews with fresh eyes. Uses different model than code to catch model-blindness bugs.",
      "path": "/home/ldco/.config/nocowboy/agent/overseer.md",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "semantic_search": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": "allow",
        "edit": "allow",
        "mcp": "allow",
        "skill": "allow",
        "recall": "allow",
        "external_directory": "allow",
        "question": "allow"
      }
    },
    "jurist": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "description": "Russian IT law specialist. 152-ФЗ, personal data, Roskomnadzor, IP, IT regulation.",
      "groups": ["read"],
      "edit": "deny",
      "webfetch": "allow",
      "websearch": "allow",
      "question": "allow"
    }
  }
}
