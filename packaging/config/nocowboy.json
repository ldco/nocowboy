{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "plugin-registry": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9200/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9201/mcp",
      "enabled": true
    },
    "sqlite": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9202/mcp",
      "enabled": true
    },
    "puppeteer": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9203/mcp",
      "enabled": true
    },
    "nutausik": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9210/mcp",
      "enabled": true
    },
    "git": {
      "type": "remote",
      "vendor": "community",
      "url": "http://127.0.0.1:9205/mcp",
      "enabled": true
    },
    "puppetmaster": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9206/mcp",
      "enabled": true
    },
    "ralph": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9207/mcp",
      "enabled": true
    },
    "constitution": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9208/mcp",
      "enabled": true
    },
    "ncp-validator": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9209/mcp",
      "enabled": true
    },
    "contract-guard": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9210/mcp",
      "enabled": true
    },
    "score-engine": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9211/mcp",
      "enabled": true
    },
    "hooks": {
      "type": "remote",
      "vendor": "nocowboy",
      "url": "http://127.0.0.1:9212/mcp",
      "enabled": true
    }
  },
  "lsp": true,
  "indexing": {
    "enabled": true,
    "provider": "voyage",
    "model": "voyage-code-3",
    "vectorStore": "lancedb"
  },
  "instructions": [
    "/home/ldco/.config/nocowboy/instructions/*.md",
    "/home/ldco/.config/nocowboy/instructions/rules/*.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "*": "allow",
    "bash": {
      "^(sudo\\s+)?rm\\s+-rf\\s+/\\s*$": "ask",
      "^(sudo\\s+)?rm\\s+-rf\\s+/*\\s*$": "ask",
      "^(sudo\\s+)?rm\\s+-rf\\s+~\\s*$": "ask",
      "^(sudo\\s+)?rm\\s+-rf\\s+\\.\\s*$": "ask",
      "^(sudo\\s+)?dd\\s+if=": "ask",
      "^(sudo\\s+)?mkfs\\.|^(sudo\\s+)?fdisk|^(sudo\\s+)?parted|^(sudo\\s+)?mkswap": "ask",
      "^[Dd][Rr][Oo][Pp]\\s+(DATABASE|TABLE|SCHEMA|INDEX)": "ask",
      "^[Tt][Rr][Uu][Nn][Cc][Aa][Tt][Ee]\\b": "ask",
      "^redis-cli\\b.*(FLUSHALL|FLUSHDB)": "ask",
      "^mongo\\b.*db\\.dropDatabase": "ask",
      "^(sudo\\s+)?chmod\\s+777\\s+/": "ask",
      "^git\\s+push\\s+.*(--force|-f)\\b": "ask",
      "*": "allow"
    },
    "edit": {
      "(^|/)kilo\\.json$": "ask",
      "(^|/)nocowboy\\.json$": "ask",
      "*": "allow"
    }
  },
  "provider": {
    "kimi-for-coding": {
      "api": "https://api.moonshot.ai/v1",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["MOONSHOT_API_KEY"],
      "models": {
        "kimi-k2.7-code": { "isFree": false, "cost": { "input": 0.6, "output": 2.5 } },
        "kimi-k2.7-code-highspeed": { "isFree": false, "cost": { "input": 0.6, "output": 2.5 } },
        "kimi-k2.6": { "isFree": false, "cost": { "input": 0.6, "output": 2.5 } },
        "kimi-k3": {
          "isFree": false,
          "cost": { "input": 2, "output": 8 },
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        }
      }
    }
  },
  "agent": {
    "architect": {
      "mode": "all",
      "model": "deepseek/deepseek-v4-pro",
      "description": "Senior Software Architect — deep design analysis, ADRs, trade-off evaluation, C4 modeling, NFR-driven architecture",
      "path": "~/.config/nocowboy/agent/architect.md",
      "permission": {
        "mcp": { "nutausik_*": "allow", "*": "deny" },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "plan_exit": "allow"
      }
    },
    "planner": {
      "mode": "all",
      "model": "deepseek/deepseek-v4-pro",
      "description": "Planning, specification, acceptance criteria — read-only",
      "path": "~/.config/nocowboy/agent/planner.md",
      "permission": {
        "mcp": { "nutausik_*": "allow", "*": "deny" },
        "read": "allow",
        "edit": {
          "*": "deny",
          "docs/*.md": "allow",
          "docs/*.json": "allow",
          "prd.json": "allow",
          ".nocowboy/plans/*.md": "allow"
        },
        "bash": "allow",
        "plan_exit": "allow"
      }
    },
    "worker": {
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash",
      "description": "Primary engineering agent — implements, refactors, tests, debugs",
      "path": "~/.config/nocowboy/agent/worker.md",
      "permission": {
        "mcp": { "nutausik_*": "allow", "*": "deny" },
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "search_replace": "allow",
        "todowrite": "allow",
        "skill": "allow"
      }
    },
    "reviewer": {
      "mode": "all",
      "model": "kimi-for-coding/kimi-k2.7-code",
      "fallback_model": "deepseek/deepseek-v4-pro",
      "description": "Reviews work against acceptance criteria — read-only, different model",
      "path": "~/.config/nocowboy/agent/reviewer.md",
      "permission": {
        "mcp": { "nutausik_*": "allow", "*": "deny" },
        "read": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "plan_exit": "allow"
      }
    },
    "auto": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "description": "Dispatcher — decides which agent to run for the current task, then launches it via task",
      "path": "~/.config/nocowboy/agent/auto.md",
      "permission": {
        "mcp": { "nutausik_*": "allow", "*": "deny" },
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "skill": "allow"
      }
    }
  }
}
