post_install() {
  echo "Enabling NoCowboy MCP services..."
  systemctl --global enable \
    nocowboy-mcp-constitution.service \
    nocowboy-mcp-contract-guard.service \
    nocowboy-mcp-ncp-validator.service \
    nocowboy-mcp-puppetmaster.service \
    nocowboy-mcp-ralph.service \
    nocowboy-mcp-score-engine.service
  systemctl --global daemon-reload
  echo "NoCowboy MCP services enabled. They will start on next login."
  echo "Run 'systemctl --user start nocowboy-mcp-constitution' to start now."
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl --global disable \
    nocowboy-mcp-constitution.service \
    nocowboy-mcp-contract-guard.service \
    nocowboy-mcp-ncp-validator.service \
    nocowboy-mcp-puppetmaster.service \
    nocowboy-mcp-ralph.service \
    nocowboy-mcp-score-engine.service
}
