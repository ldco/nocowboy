_mcp_services="
  nocowboy-mcp-constitution.service
  nocowboy-mcp-contract-guard.service
  nocowboy-mcp-ncp-validator.service
  nocowboy-mcp-puppetmaster.service
  nocowboy-mcp-ralph.service
  nocowboy-mcp-score-engine.service
"

_prefixed="nocowboy-mcp-"

_user_start() {
  local user="${SUDO_USER:-$USER}"
  systemctl --global daemon-reload 2>/dev/null || true
  for svc in $_mcp_services; do
    systemctl --global enable "$svc" 2>/dev/null || true
  done
  # User services need the actual user's session bus — run as the user
  if command -v sudo &>/dev/null && [ -n "$user" ]; then
    sudo -u "$user" systemctl --user daemon-reload 2>/dev/null || true
    for svc in $_mcp_services; do
      sudo -u "$user" systemctl --user start "$svc" 2>/dev/null || true
    done
    loginctl enable-linger "$user" 2>/dev/null || true
  fi
}

_user_stop() {
  local user="${SUDO_USER:-$USER}"
  if command -v sudo &>/dev/null && [ -n "$user" ]; then
    for svc in $_mcp_services; do
      sudo -u "$user" systemctl --user stop "$svc" 2>/dev/null || true
    done
  fi
}

_user_disable() {
  local user="${SUDO_USER:-$USER}"
  for svc in $_mcp_services; do
    systemctl --global disable "$svc" 2>/dev/null || true
  done
  if command -v sudo &>/dev/null && [ -n "$user" ]; then
    for svc in $_mcp_services; do
      sudo -u "$user" systemctl --user disable "$svc" 2>/dev/null || true
    done
  fi
}

post_install() {
  _user_start
}

post_upgrade() {
  # Enable + start any new MCP services shipped in this version
  _user_start

  # Disable + stop any previously enabled MCP services that are no longer shipped
  shipped=" $(echo $_mcp_services) "
  enabled=$(systemctl --global list-unit-files --type=service 2>/dev/null \
    | grep "^${_prefixed}" \
    | grep ' enabled$' \
    | awk '{print $1}') || true
  for svc in $enabled; do
    if ! echo "$shipped" | grep -q " ${svc} "; then
      if command -v sudo &>/dev/null && [ -n "${SUDO_USER:-$USER}" ]; then
        sudo -u "${SUDO_USER:-$USER}" systemctl --user stop "$svc" 2>/dev/null || true
      fi
      systemctl --global disable "$svc" 2>/dev/null || true
    fi
  done

  systemctl --global daemon-reload 2>/dev/null || true
}

pre_remove() {
  _user_stop
  _user_disable
}
