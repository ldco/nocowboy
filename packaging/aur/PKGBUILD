pkgname=nocowboy
pkgver=0.4.0
pkgrel=1
pkgdesc="AI-powered development tool — agentic coding for the Russian market"
arch=('x86_64')
url="https://github.com/ldco/nocowboy"
license=('LicenseRef-custom')
options=('!strip' '!debug')  # Bun-compiled binary must NOT be stripped (removes embedded app)
depends=('glibc' 'nodejs')
makedepends=('npm')

install=nocowboy.install
source=("nocowboy-linux-x64.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}"
  for server in mcp-servers/*/; do
    cd "$server" && npm install --prod --ignore-scripts 2>/dev/null && cd ../..
  done
}

package() {
  cd "${srcdir}"

  # Binary + sidecars (models snapshot + tree-sitter wasms) must live together
  install -Dm755 nocowboy "${pkgdir}/usr/lib/nocowboy/nocowboy"
  install -Dm644 models-snapshot.json "${pkgdir}/usr/lib/nocowboy/models-snapshot.json"
  mkdir -p "${pkgdir}/usr/lib/nocowboy/tree-sitter"
  cp -r tree-sitter/. "${pkgdir}/usr/lib/nocowboy/tree-sitter/"

  # Wrapper on PATH that points the binary at its sidecars
  install -dm755 "${pkgdir}/usr/bin"
  printf '%s\n' '#!/bin/sh' \
    'export KILO_TREE_SITTER_WASM_DIR=/usr/lib/nocowboy/tree-sitter' \
    'exec /usr/lib/nocowboy/nocowboy "$@"' > "${pkgdir}/usr/bin/nocowboy"
  chmod 755 "${pkgdir}/usr/bin/nocowboy"

  # Default config
  mkdir -p "${pkgdir}/usr/share/nocowboy"
  cp -r config/. "${pkgdir}/usr/share/nocowboy/config/"

  # MCP servers with installed node_modules
  cp -r mcp-servers/. "${pkgdir}/usr/share/nocowboy/mcp-servers/"

  # Systemd service files
  mkdir -p "${pkgdir}/usr/lib/systemd/user"
  cp systemd/*.service "${pkgdir}/usr/lib/systemd/user/"
}
