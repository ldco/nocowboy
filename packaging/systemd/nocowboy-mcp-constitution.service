[Unit]
Description=NoCowboy MCP: constitution
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/nocowboy/mcp-servers/constitution/dist/index.js
WorkingDirectory=/usr/share/nocowboy/mcp-servers/constitution
Environment=NODE_ENV=production
Environment=PORT=8216
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
