[Unit]
Description=NoCowboy MCP: puppetmaster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/nocowboy/proxy/node_modules/mcp-proxy/dist/bin/mcp-proxy.mjs --port 8203 -- /usr/bin/node /usr/share/nocowboy/mcp-servers/puppetmaster/dist/index.js
WorkingDirectory=/usr/share/nocowboy/mcp-servers/puppetmaster
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
