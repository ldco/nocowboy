[Unit]
Description=NoCowboy MCP: ncp-validator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/nocowboy/mcp-servers/ncp-validator/dist/index.js
WorkingDirectory=/usr/share/nocowboy/mcp-servers/ncp-validator
Environment=NODE_ENV=production
Environment=PORT=8217
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
