[Unit]
Description=NoCowboy MCP: puppeteer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/nocowboy/proxy/node_modules/mcp-proxy/dist/bin/mcp-proxy.mjs --port 8202 -- /usr/bin/npx puppeteer-mcp-claude serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
