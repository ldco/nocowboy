[Unit]
Description=NoCowboy MCP: git
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/nocowboy/proxy/node_modules/mcp-proxy/dist/bin/mcp-proxy.mjs --port 8205 -- uvx mcp-server-git
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
