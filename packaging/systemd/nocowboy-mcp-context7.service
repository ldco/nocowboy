[Unit]
Description=NoCowboy MCP: context7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/nocowboy/proxy/node_modules/mcp-proxy/dist/bin/mcp-proxy.mjs --port 8200 -- /usr/bin/npx -y @upstash/context7-mcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
