[Unit]
Description=NoCowboy MCP: sqlite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/nocowboy/proxy/node_modules/mcp-proxy/dist/bin/mcp-proxy.mjs --port 8201 -- /usr/bin/npx mcp-sqlite-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
